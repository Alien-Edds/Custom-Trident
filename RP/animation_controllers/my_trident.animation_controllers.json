{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.custom_trident.my_trident.wield": {
			"initial_state": "first_person",
			"states": {
				"first_person": {
					"animations": [
						"wield_first_person",
						"controller_wield_first_person"
					],
					"transitions": [
						{
							"third_person": "!c.is_first_person"
						}
					]
				},
				"third_person": {
					"animations": [
						"wield_third_person",
						{
							"wield_third_person_raise": "query.main_hand_item_use_duration > 0.0f || query.has_target"
						}
					],
					"transitions": [
						{
							"first_person": "c.is_first_person"
						}
					]
				}
			}
		},
		"controller.animation.custom_trident.my_trident.first_person_wield": {
			"initial_state": "default",
			"states": {
				"default": {
				"transitions": [
					{
						"using": "query.main_hand_item_use_duration > 0.0f"
					}
				]
				},
				"using": {
					"animations": [
						"wield_first_person_raise",
						"wield_first_person_raise_shake"
					],
					"transitions": [
						{
							"default": "query.main_hand_item_use_duration <= 0.0f && !q.is_in_water_or_rain"
						},
						{
							"riptide": "query.main_hand_item_use_duration <= 0.0f && q.is_in_water_or_rain"
						}
					]
				},
				"riptide": {
					"animations": [
						"wield_first_person_riptide"
					],
					"transitions": [
						{
							"default": "q.all_animations_finished"
						}
					]
				}
			}
		}
	}
}